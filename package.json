{
  "name": "creative-veto-court",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node frontend/server.mjs",
    "build": "node frontend/build.mjs",
    "check": "node --check frontend/public/app.mjs && node --check frontend/public/hearing.mjs && node --check frontend/server.mjs && node --check frontend/public/court.mjs && node --check frontend/public/judges.mjs && node --check frontend/public/avatars.mjs",
    "test:frontend": "node --test test/frontend*.test.mjs",
    "test:integration": "node --test test/frontend-proxy.test.mjs",
    "test:integration:browser": "node test/frontend-live-browser.mjs",
    "init": "node scripts/init-env.mjs",
    "setup": "node scripts/setup-room.mjs",
    "setup:engine": "node scripts/setup-engine.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "check:negotiation": "node scripts/check-negotiation.mjs",
    "spike": "node scripts/run-spike.mjs",
    "check:listener": "node scripts/check-listener.mjs",
    "check:clerk": "node scripts/check-clerk.mjs",
    "listen": "node scripts/listen.mjs",
    "status": "node scripts/status.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node scripts/verify-receipt.mjs"
  }
}
